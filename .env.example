# Copy to .env and fill in. .env is git-ignored.

# Gemini API key for LLM-written reports (optional: template fallback without it)
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# PostgreSQL. Matches docker-compose (host port 5433) when running scripts locally.
DATABASE_URL=postgresql://bloodcell:bloodcell@localhost:5433/bloodcell
POSTGRES_PASSWORD=bloodcell

# Inference
BCV_MODEL_PATH=models/best.pt
BCV_DEVICE=auto          # auto | cpu | mps | 0 (CUDA GPU index)
BCV_CONF=0.25
BCV_IOU=0.5             # NMS IoU; counting thresholds were calibrated with this value
BCV_LOW_CONF=0.5
BCV_OVERLAP_IOU=0.5

# Host ports (change if already in use)
API_PORT=8000
DASHBOARD_PORT=8501
DB_PORT=5433
